# Provider ochrany formuláře: turnstile (výchozí), recaptcha nebo none.
# Musí odpovídat hodnotě captcha_provider v public/api/config.php.
VITE_CAPTCHA_PROVIDER=turnstile

# Veřejný site key z Cloudflare Turnstile (není tajný).
# Testovací klíč pro vývoj (vždy projde): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Veřejný site key Google reCAPTCHA v2 (checkbox; není tajný).
# Testovací klíč (vždy projde): 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
VITE_RECAPTCHA_SITE_KEY=

# Volitelné: jiná URL endpointu (výchozí /api/contact.php)
# VITE_CONTACT_ENDPOINT=/api/contact.php

# Volitelné: kam Vite dev server proxuje /api (php -S localhost:8000 -t public)
# VITE_DEV_API_PROXY=http://localhost:8000
